# ============================================================
# GESTION SERVICE API — Secrets Template
# Copier ce fichier en application-secrets.yml à la racine
# et renseigner les vraies valeurs.
# CE FICHIER NE DOIT JAMAIS ÊTRE COMMITÉ.
# ============================================================

# ===== DATABASE =====
DATABASE_URL: jdbc:postgresql://localhost:5432/gestion_service_db
DATABASE_USERNAME: postgres
DATABASE_PASSWORD: change_me_with_a_strong_password

# ===== JWT =====
# Clé secrète de signature HS256 (min 32 caractères).
# Ne pas la commiter ni la changer sans invalider tous les jetons en cours.
JWT_SECRET: change_me_with_a_very_long_secret_key_at_least_32_chars
# Émetteur attendu sur les jetons locaux (sub = gestion_account.id).
# Les jetons legacy (sub = telephone) n'en portent pas.
JWT_ISSUER: gestion-service
# Durée de vie d'un access token, en millisecondes. 3600000 = 1 h.
JWT_EXPIRATION: 3600000

# ===== ADMIN SEED (Étape 4) =====
# Compte ADMIN initial. Utilisé UNE SEULE FOIS : si un ROLE_ADMIN existe
# déjà, ces valeurs sont ignorées et le compte existant n'est pas modifié.
# Le seeder n'est jamais exécuté si ADMIN_SEED_ENABLED=false.
ADMIN_SEED_ENABLED: true
ADMIN_SEED_FULL_NAME: Administrator
ADMIN_SEED_TELEPHONE: 771234567
ADMIN_SEED_EMAIL: admin@example.com
# OBLIGATOIRE : sans cette valeur, le démarrage échoue tant qu'aucun
# ADMIN n'existe. À changer après la première connexion.
ADMIN_SEED_PASSWORD: change_me_with_a_strong_password

# ===== WALLET SERVICE =====
WALLET_SERVICE_URL: http://localhost:8081

# ===== WALLET INTERNAL API KEY (service-to-service auth) =====
# Doit être identique à internal.api.key dans banque1_api.
# Nécessaire pour les appels /internal/** vers le Wallet.
WALLET_INTERNAL_API_KEY: change_me_with_a_strong_internal_api_key

# ===== GMAIL SMTP — Envoi d'emails transactionnels =====
# Adresse Gmail utilisée comme expéditeur (identique à spring.mail.username).
MAIL_USERNAME: mon-adresse@gmail.com
# Mot de passe d'application Google de 16 caractères (jamais le mot de passe
# Google habituel). Obtenir sur https://myaccount.google.com/apppasswords.
# NE JAMAIS COMMITTER NI LOGGER.
MAIL_PASSWORD: change_me_with_your_16_char_app_password
