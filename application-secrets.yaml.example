# Copier ce fichier en application-secrets.yaml (à la racine du projet) et
# renseigner les vraies valeurs. Ce fichier n'est jamais commité (voir .gitignore).

# Doit avoir EXACTEMENT la même valeur que WALLET_INTERNAL_API_KEY dans gestion-service.
# Utilisée pour sécuriser les appels serveur-à-serveur vers banque1_api.
INTERNAL_API_KEY: change_moi_avec_un_secret_long_et_aleatoire

BANQUE_API_URL: http://localhost:8080
